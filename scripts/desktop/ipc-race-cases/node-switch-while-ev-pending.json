{
  "id": "node-switch-while-ev-pending",
  "title": "Switch nodes while EV is pending — later node demuxes by request_id while the first values reply stays withheld",
  "sidecar": "test",
  "build_sha": null,
  "input": {},
  "actions": [
    {
      "op": "ready",
      "id": "ready",
      "expect": { "ok": true, "body.protocol": 2 }
    },
    {
      "op": "values",
      "id": "values-node-0",
      "body": { "node_index": 0, "node_id": "root" },
      "expect": "pending",
      "settle_ms": 120
    },
    { "sleep_ms": 40 },
    {
      "op": "values",
      "id": "values-node-1",
      "body": { "node_index": 1, "node_id": "p0" },
      "timeout_s": 5,
      "expect": { "ok": true }
    },
    {
      "op": "status",
      "id": "status",
      "expect": { "ok": true, "body.held_values": true }
    },
    { "assert_pending": ["values-node-0"], "settle_ms": 80 }
  ],
  "expected": {
    "pending": ["values-node-0"],
    "replies": {
      "values-node-1": { "ok": true },
      "status": { "ok": true, "body.held_values": true }
    }
  }
}
