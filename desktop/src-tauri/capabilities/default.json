{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Hold'em Study (webview + Zig solver-engine sidecar)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "solver-engine",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/solver-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
