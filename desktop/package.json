{
  "name": "poker-solver-desktop",
  "private": true,
  "version": "0.1.7",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public-demo": "tsc -b && vite build --mode public-demo",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:public-demo": "vite preview --outDir dist-public-demo --host 127.0.0.1 --port 4173 --strictPort",
    "preview:scenario": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "river-beta": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test e2e/node-locking-preview.spec.ts",
    "test:e2e:public-demo": "playwright test -c playwright.public-demo.config.ts",
    "sync:ai-context": "node ./scripts/sync-ai-context-packs.mjs",
    "check:ai-context": "node ./scripts/sync-ai-context-packs.mjs --check",
    "check:library-assets": "node ./scripts/validate-library-assets.mjs",
    "test:assistant-live": "node ./scripts/run-assistant-live-eval.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.2.0",
    "@tauri-apps/plugin-shell": "2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
